{% extends 'base.html.twig' %}
{% block title %}Jeu responsable{% endblock %}

{% block body %}
<div class="flex items-center gap-3 mb-6">
    <i data-lucide="shield-alert" class="w-7 h-7 text-warning"></i>
    <h1 class="text-2xl font-bold">Jeu responsable</h1>
</div>

{# Statut actuel #}
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="stat bg-base-100 rounded-2xl shadow">
        <div class="stat-figure text-primary"><i data-lucide="wallet" class="w-8 h-8"></i></div>
        <div class="stat-title">Solde</div>
        <div class="stat-value text-primary">{{ user.balance|number_format(2) }} €</div>
    </div>
    <div class="stat bg-base-100 rounded-2xl shadow">
        <div class="stat-figure {{ user.currentlySelfExcluded ? 'text-error' : 'text-success' }}">
            <i data-lucide="{{ user.currentlySelfExcluded ? 'ban' : 'circle-check' }}" class="w-8 h-8"></i>
        </div>
        <div class="stat-title">Statut</div>
        <div class="stat-value text-sm {{ user.currentlySelfExcluded ? 'text-error' : 'text-success' }}">
            {% if user.isSuspended %}Suspendu
            {% elseif user.currentlySelfExcluded %}Auto-exclu
            {% else %}Actif{% endif %}
        </div>
        {% if user.currentlySelfExcluded %}
            <div class="stat-desc text-error">jusqu'au {{ user.selfExcludedUntil|date('d/m/Y') }}</div>
        {% endif %}
    </div>
    <div class="stat bg-base-100 rounded-2xl shadow">
        <div class="stat-figure text-info"><i data-lucide="sliders-horizontal" class="w-8 h-8"></i></div>
        <div class="stat-title">Limites actives</div>
        <div class="stat-value text-sm">
            {% set count = 0 %}
            {% if user.dailyBetLimit %}{% set count = count + 1 %}{% endif %}
            {% if user.weeklyBetLimit %}{% set count = count + 1 %}{% endif %}
            {% if user.dailyDepositLimit %}{% set count = count + 1 %}{% endif %}
            {% if user.weeklyDepositLimit %}{% set count = count + 1 %}{% endif %}
            {{ count }}/4
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    {# Auto-exclusion #}
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <h2 class="card-title gap-2">
                <i data-lucide="ban" class="w-5 h-5 text-error"></i>
                Auto-exclusion
            </h2>
            <p class="text-sm text-base-content/60 mb-3">
                Bloquez-vous temporairement. L'exclusion est immédiate et irrévocable pendant la durée choisie.
            </p>
            {% if user.currentlySelfExcluded %}
                <div class="alert alert-error text-sm">
                    <i data-lucide="ban" class="w-4 h-4"></i>
                    Auto-exclusion active jusqu'au <strong>{{ user.selfExcludedUntil|date('d/m/Y à H:i') }}</strong>
                </div>
            {% elseif user.isSuspended %}
                <div class="alert alert-warning text-sm">
                    <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                    Compte suspendu par un administrateur.
                </div>
            {% else %}
                <form method="post" action="{{ path('user_rg_self_exclude') }}"
                      onsubmit="return confirm('Êtes-vous sûr ? Cette action est irréversible pendant la durée choisie.')">
                    <div class="form-control gap-2">
                        <label class="label"><span class="label-text font-medium">Durée d'exclusion</span></label>
                        <select name="days" class="select select-bordered select-sm">
                            <option value="7">7 jours</option>
                            <option value="30" selected>30 jours</option>
                            <option value="90">90 jours</option>
                            <option value="180">6 mois</option>
                            <option value="365">1 an</option>
                        </select>
                        <button class="btn btn-error btn-sm gap-1 mt-2">
                            <i data-lucide="ban" class="w-4 h-4"></i> M'auto-exclure
                        </button>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>

    {# Limites de mise #}
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <h2 class="card-title gap-2">
                <i data-lucide="target" class="w-5 h-5 text-primary"></i>
                Limites de mise
            </h2>
            <p class="text-sm text-base-content/60 mb-3">
                Les diminutions sont immédiates. Les augmentations s'appliquent après 48h.
            </p>
            <form method="post" action="{{ path('user_rg_bet_limit') }}" class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="label pb-1"><span class="label-text text-xs">Quotidien (€)</span></label>
                        <input type="number" name="daily_bet_limit" min="1" step="0.01"
                               value="{{ user.dailyBetLimit }}"
                               placeholder="Sans limite"
                               class="input input-bordered input-sm w-full" />
                        {% if user.pendingDailyBetLimit %}
                            <p class="text-xs text-warning mt-1 flex items-center gap-1">
                                <i data-lucide="clock" class="w-3 h-3"></i>
                                En attente : {{ user.pendingDailyBetLimit }} € (48h)
                            </p>
                        {% endif %}
                    </div>
                    <div>
                        <label class="label pb-1"><span class="label-text text-xs">Hebdomadaire (€)</span></label>
                        <input type="number" name="weekly_bet_limit" min="1" step="0.01"
                               value="{{ user.weeklyBetLimit }}"
                               placeholder="Sans limite"
                               class="input input-bordered input-sm w-full" />
                        {% if user.pendingWeeklyBetLimit %}
                            <p class="text-xs text-warning mt-1 flex items-center gap-1">
                                <i data-lucide="clock" class="w-3 h-3"></i>
                                En attente : {{ user.pendingWeeklyBetLimit }} € (48h)
                            </p>
                        {% endif %}
                    </div>
                </div>
                <div class="flex gap-2">
                    <button class="btn btn-primary btn-sm flex-1 gap-1">
                        <i data-lucide="save" class="w-4 h-4"></i> Enregistrer
                    </button>
                    <button type="submit" name="remove_daily_bet" class="btn btn-ghost btn-sm gap-1"
                            title="Supprimer limite quotidienne">
                        <i data-lucide="x" class="w-4 h-4"></i> Suppr. quotidien
                    </button>
                    <button type="submit" name="remove_weekly_bet" class="btn btn-ghost btn-sm gap-1"
                            title="Supprimer limite hebdomadaire">
                        <i data-lucide="x" class="w-4 h-4"></i> Suppr. hebdo
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Limites de dépôt #}
    <div class="card bg-base-100 shadow lg:col-span-2">
        <div class="card-body">
            <h2 class="card-title gap-2">
                <i data-lucide="piggy-bank" class="w-5 h-5 text-success"></i>
                Limites de dépôt
            </h2>
            <p class="text-sm text-base-content/60 mb-3">
                Plafonnez vos dépôts quotidiens et hebdomadaires. Les modifications sont immédiates.
            </p>
            <form method="post" action="{{ path('user_rg_deposit_limit') }}" class="space-y-3">
                <div class="grid grid-cols-2 gap-3 max-w-md">
                    <div>
                        <label class="label pb-1"><span class="label-text text-xs">Quotidien (€)</span></label>
                        <input type="number" name="daily_deposit_limit" min="1" step="0.01"
                               value="{{ user.dailyDepositLimit }}"
                               placeholder="Sans limite"
                               class="input input-bordered input-sm w-full" />
                    </div>
                    <div>
                        <label class="label pb-1"><span class="label-text text-xs">Hebdomadaire (€)</span></label>
                        <input type="number" name="weekly_deposit_limit" min="1" step="0.01"
                               value="{{ user.weeklyDepositLimit }}"
                               placeholder="Sans limite"
                               class="input input-bordered input-sm w-full" />
                    </div>
                </div>
                <div class="flex gap-2">
                    <button class="btn btn-success btn-sm gap-1">
                        <i data-lucide="save" class="w-4 h-4"></i> Enregistrer
                    </button>
                    <button type="submit" name="remove_daily_deposit" class="btn btn-ghost btn-sm gap-1">
                        <i data-lucide="x" class="w-4 h-4"></i> Suppr. quotidien
                    </button>
                    <button type="submit" name="remove_weekly_deposit" class="btn btn-ghost btn-sm gap-1">
                        <i data-lucide="x" class="w-4 h-4"></i> Suppr. hebdo
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<div class="alert alert-warning mt-8 text-sm">
    <i data-lucide="phone" class="w-5 h-5 shrink-0"></i>
    <span>Besoin d'aide ? <strong>Joueurs Info Service : 09 74 75 13 13</strong> — Gratuit, confidentiel, 7j/7.</span>
</div>
{% endblock %}
