<!DOCTYPE html>
<html data-theme="night" lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Nexus Bet{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
    {% block stylesheets %}{% endblock %}
</head>
<body class="flex flex-col min-h-screen bg-base-200">

<nav class="navbar bg-base-100 shadow-lg px-6 sticky top-0 z-50">
    <div class="navbar-start">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2 text-xl font-bold text-primary">
            <i data-lucide="sword" class="w-6 h-6"></i>
            Nexus Bet
        </a>
    </div>

    <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 gap-1">
            <li>
                <a href="{{ path('app_home') }}" class="flex items-center gap-1.5">
                    <i data-lucide="trophy" class="w-4 h-4"></i> Matchs
                </a>
            </li>
            <li>
                <a href="{{ path('codex_index') }}" class="flex items-center gap-1.5">
                    <i data-lucide="book-open" class="w-4 h-4"></i> Codex
                </a>
            </li>
            <li>
                <a href="{{ path('summoner_search') }}" class="flex items-center gap-1.5">
                    <i data-lucide="user-search" class="w-4 h-4"></i> Joueurs
                </a>
            </li>
            {% if is_granted('ROLE_USER') %}
                <li>
                    <a href="{{ path('user_bet_index') }}" class="flex items-center gap-1.5">
                        <i data-lucide="target" class="w-4 h-4"></i> Mes paris
                    </a>
                </li>
                <li>
                    <a href="{{ path('user_wallet_index') }}" class="flex items-center gap-1.5">
                        <i data-lucide="wallet" class="w-4 h-4"></i> Portefeuille
                    </a>
                </li>
                <li>
                    <a href="{{ path('user_rg_index') }}" class="flex items-center gap-1.5">
                        <i data-lucide="shield-alert" class="w-4 h-4"></i> Jeu responsable
                    </a>
                </li>
            {% endif %}
            {% if is_granted('ROLE_MANAGER') %}
                <li>
                    <a href="{{ path('manager_event_index') }}" class="flex items-center gap-1.5">
                        <i data-lucide="settings-2" class="w-4 h-4"></i> Gestion matchs
                    </a>
                </li>
                <li>
                    <a href="{{ path('manager_import_index') }}" class="flex items-center gap-1.5">
                        <i data-lucide="download-cloud" class="w-4 h-4"></i> Import Esports
                    </a>
                </li>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('admin_user_index') }}" class="flex items-center gap-1.5">
                        <i data-lucide="shield" class="w-4 h-4"></i> Utilisateurs
                    </a>
                </li>
                <li>
                    <a href="{{ path('admin_stats_index') }}" class="flex items-center gap-1.5">
                        <i data-lucide="bar-chart-2" class="w-4 h-4"></i> Statistiques
                    </a>
                </li>
            {% endif %}
        </ul>
    </div>

    <div class="navbar-end gap-3">
        {% if app.user %}
            <div class="flex items-center gap-2 text-sm">
                <i data-lucide="user-circle" class="w-4 h-4 text-base-content/50"></i>
                <span class="text-base-content/70">{{ app.user.username }}</span>
            </div>
            <div class="badge badge-primary gap-1">
                <i data-lucide="coins" class="w-3 h-3"></i>
                {{ app.user.balance|number_format(2) }} €
            </div>
            <a href="{{ path('app_logout') }}" class="btn btn-ghost btn-sm gap-1.5">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                Déconnexion
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-ghost btn-sm gap-1.5">
                <i data-lucide="log-in" class="w-4 h-4"></i>
                Connexion
            </a>
            <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm gap-1.5">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                S'inscrire
            </a>
        {% endif %}
    </div>
</nav>

<main class="flex-1 container mx-auto px-4 py-8">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            {% if type == 'success' %}
                {% set alertClass = 'alert-success' %}
                {% set iconName   = 'circle-check' %}
            {% elseif type == 'warning' %}
                {% set alertClass = 'alert-warning' %}
                {% set iconName   = 'triangle-alert' %}
            {% elseif type == 'info' %}
                {% set alertClass = 'alert-info' %}
                {% set iconName   = 'info' %}
            {% else %}
                {% set alertClass = 'alert-error' %}
                {% set iconName   = 'circle-x' %}
            {% endif %}
            <div class="alert {{ alertClass }} mb-4 flex items-center gap-2">
                <i data-lucide="{{ iconName }}" class="w-5 h-5 shrink-0"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="footer footer-center p-4 bg-base-100 border-t border-base-300 text-base-content/40 text-xs">
    <div class="flex items-center gap-2">
        <i data-lucide="shield-alert" class="w-4 h-4"></i>
        <p>Nexus Bet — Plateforme fictive · Jouer comporte des risques, jouez de façon responsable. Interdit aux moins de 18 ans.</p>
    </div>
</footer>

<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script>lucide.createIcons();</script>
{% block javascripts %}{% endblock %}
</body>
</html>
