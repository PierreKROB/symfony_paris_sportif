{% extends 'base.html.twig' %}

{% block title %}Nouveau match{% endblock %}

{% block body %}
<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">➕ Nouveau match</h1>
    <a href="{{ path('manager_event_index') }}" class="btn btn-ghost btn-sm">← Retour</a>
</div>

<div class="card bg-base-100 shadow-xl max-w-lg">
    <div class="card-body">
        {{ form_start(form, {attr: {class: 'space-y-4', enctype: 'multipart/form-data'}}) }}

            {{ form_row(form.name,       {attr: {class: 'input input-bordered w-full mt-1'}}) }}
            {{ form_row(form.sport,      {attr: {class: 'input input-bordered w-full mt-1'}}) }}
            {{ form_row(form.tournament, {attr: {class: 'input input-bordered w-full mt-1'}}) }}
            {{ form_row(form.teamA,      {attr: {class: 'input input-bordered w-full mt-1'}}) }}
            {{ form_row(form.teamB,      {attr: {class: 'input input-bordered w-full mt-1'}}) }}
            {{ form_row(form.startsAt,   {attr: {class: 'input input-bordered w-full mt-1'}}) }}

            <div class="grid grid-cols-2 gap-4">
                <div class="form-control">
                    {{ form_label(form.logoAFile, null, {label_attr: {class: 'label-text font-medium'}}) }}
                    {{ form_widget(form.logoAFile, {attr: {class: 'file-input file-input-bordered w-full mt-1 file-input-sm'}}) }}
                    {{ form_errors(form.logoAFile) }}
                </div>
                <div class="form-control">
                    {{ form_label(form.logoBFile, null, {label_attr: {class: 'label-text font-medium'}}) }}
                    {{ form_widget(form.logoBFile, {attr: {class: 'file-input file-input-bordered w-full mt-1 file-input-sm'}}) }}
                    {{ form_errors(form.logoBFile) }}
                </div>
            </div>

            <div class="alert alert-info text-sm">
                <i data-lucide="info" class="w-4 h-4"></i>
                Les issues (Victoire équipe A / B) seront créées automatiquement avec une cote de 1.50.
            </div>
            <button type="submit" class="btn btn-primary w-full">Créer le match</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
