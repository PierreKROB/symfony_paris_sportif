{% extends 'base.html.twig' %}

{% block title %}Gestion des matchs{% endblock %}

{% block body %}
<div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-3">
        <i data-lucide="settings-2" class="w-7 h-7 text-primary"></i>
        <h1 class="text-2xl font-bold">Gestion des matchs</h1>
    </div>
    <a href="{{ path('manager_event_new') }}" class="btn btn-primary btn-sm gap-1.5">
        <i data-lucide="plus" class="w-4 h-4"></i> Nouveau match
    </a>
</div>

<div class="overflow-x-auto">
    <table class="table table-zebra w-full">
        <thead>
            <tr>
                <th>Match</th>
                <th>Tournoi</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for event in events %}
            <tr>
                <td class="font-semibold">{{ event.teamA }} vs {{ event.teamB }}</td>
                <td class="text-base-content/60">{{ event.tournament }}</td>
                <td class="text-sm">{{ event.startsAt|date('d/m/Y H:i') }}</td>
                <td>
                    {% set badgeClass = {
                        'BROUILLON': 'badge-ghost',
                        'PUBLIE':    'badge-success',
                        'FERME':     'badge-warning',
                        'TERMINE':   'badge-info',
                        'ANNULE':    'badge-error'
                    }[event.status] ?? 'badge-ghost' %}
                    <span class="badge {{ badgeClass }} badge-sm">{{ event.status }}</span>
                </td>
                <td>
                    <div class="flex gap-1 flex-wrap">
                        {% if event.status == 'BROUILLON' %}
                            <form method="post" action="{{ path('manager_event_publish', {id: event.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('publish'~event.id) }}">
                                <button class="btn btn-success btn-xs gap-1">
                                    <i data-lucide="send" class="w-3 h-3"></i> Publier
                                </button>
                            </form>
                            <form method="post" action="{{ path('manager_event_delete', {id: event.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~event.id) }}">
                                <button class="btn btn-error btn-xs gap-1">
                                    <i data-lucide="trash-2" class="w-3 h-3"></i> Supprimer
                                </button>
                            </form>
                        {% endif %}
                        {% if event.status == 'PUBLIE' %}
                            <form method="post" action="{{ path('manager_event_close', {id: event.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('close'~event.id) }}">
                                <button class="btn btn-warning btn-xs gap-1">
                                    <i data-lucide="lock" class="w-3 h-3"></i> Fermer paris
                                </button>
                            </form>
                            <form method="post" action="{{ path('manager_event_cancel', {id: event.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel'~event.id) }}">
                                <button class="btn btn-error btn-xs gap-1">
                                    <i data-lucide="x-circle" class="w-3 h-3"></i> Annuler
                                </button>
                            </form>
                        {% endif %}
                        {% if event.status == 'FERME' %}
                            {% for outcome in event.outcomes %}
                            <form method="post" action="{{ path('manager_event_result', {id: event.id}) }}">
                                <input type="hidden" name="winner_outcome_id" value="{{ outcome.id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('result'~event.id) }}">
                                <button class="btn btn-info btn-xs gap-1">
                                    <i data-lucide="check-circle" class="w-3 h-3"></i> {{ outcome.label }}
                                </button>
                            </form>
                            {% endfor %}
                        {% endif %}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-base-content/40 py-8">
                    <i data-lucide="inbox" class="w-8 h-8 mx-auto mb-2 opacity-30"></i>
                    <p>Aucun match créé.</p>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% include 'partials/pagination.html.twig' with {pagination: pagination} %}
{% endblock %}
