{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="flex items-center gap-3 mb-6">
    <i data-lucide="shield" class="w-7 h-7 text-primary"></i>
    <h1 class="text-2xl font-bold">Utilisateurs</h1>
</div>

<div class="overflow-x-auto">
    <table class="table table-zebra w-full">
        <thead>
            <tr>
                <th>Pseudo</th>
                <th>Email</th>
                <th>Solde</th>
                <th>Rôles</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td class="font-semibold flex items-center gap-2">
                    <i data-lucide="user-circle" class="w-4 h-4 text-base-content/40"></i>
                    {{ user.username }}
                </td>
                <td class="text-sm text-base-content/50">{{ user.email }}</td>
                <td class="font-mono">{{ user.balance|number_format(2) }} €</td>
                <td>
                    {% for role in user.roles %}
                        {% if role != 'ROLE_USER' %}
                            <span class="badge badge-sm badge-outline">{{ role }}</span>
                        {% endif %}
                    {% endfor %}
                </td>
                <td>
                    {% if user.isSuspended %}
                        <span class="badge badge-error badge-sm gap-1">
                            <i data-lucide="ban" class="w-3 h-3"></i> Suspendu
                        </span>
                    {% elseif user.currentlySelfExcluded %}
                        <span class="badge badge-warning badge-sm gap-1">
                            <i data-lucide="clock" class="w-3 h-3"></i> Auto-exclu
                        </span>
                    {% else %}
                        <span class="badge badge-success badge-sm gap-1">
                            <i data-lucide="circle-check" class="w-3 h-3"></i> Actif
                        </span>
                    {% endif %}
                </td>
                <td>
                    <div class="flex gap-1">
                        <form method="post" action="{{ path('admin_user_suspend', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('suspend'~user.id) }}">
                            <button class="btn btn-xs {{ user.isSuspended ? 'btn-success' : 'btn-error' }} gap-1">
                                <i data-lucide="{{ user.isSuspended ? 'user-check' : 'user-x' }}" class="w-3 h-3"></i>
                                {{ user.isSuspended ? 'Réactiver' : 'Suspendre' }}
                            </button>
                        </form>
                        <form method="post" action="{{ path('admin_user_set_manager', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('manager'~user.id) }}">
                            <button class="btn btn-xs btn-outline gap-1">
                                <i data-lucide="{{ 'ROLE_MANAGER' in user.roles ? 'shield-minus' : 'shield-plus' }}" class="w-3 h-3"></i>
                                {{ 'ROLE_MANAGER' in user.roles ? '- Manager' : '+ Manager' }}
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center text-base-content/40 py-8">
                    <i data-lucide="users" class="w-8 h-8 mx-auto mb-2 opacity-30"></i>
                    <p>Aucun utilisateur.</p>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
