[Unit]
Description=Nexus Bet — Symfony (PHP built-in :3005)
After=network.target mysql.service

[Service]
Type=simple
User=github-runner
WorkingDirectory=/home/github-runner/actions-runner/_work/symfony_paris_sportif/symfony_paris_sportif
ExecStart=php -S 0.0.0.0:3005 -t public/
Restart=on-failure
RestartSec=5s
Environment=APP_ENV=prod
Environment=APP_DEBUG=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-bet

[Install]
WantedBy=multi-user.target
